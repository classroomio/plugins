CLASSROOMIO_API_URL=http://localhost:3002
CLASSROOMIO_DEV_TOKEN=
CLASSROOMIO_ORG_ID=

# GitHub Environment: plugin-production
# Secret: CLASSROOMIO_API_URL
# Secret: PLUGIN_RELEASE_DEPLOY_TOKEN (at least 32 random characters)
# Secret: R2_ACCESS_KEY_ID (write access limited to the production plugin bucket)
# Secret: R2_SECRET_ACCESS_KEY
# Secret: R2_ENDPOINT_URL (https://<account-id>.r2.cloudflarestorage.com)
# Variable: PLUGIN_ASSET_BUCKET
