{
  "$schema": "https://classroomio.com/schemas/plugin-manifest.v1.json",
  "manifestVersion": 1,
  "id": "com.classroomio.certificate-studio",
  "name": "Certificate Studio",
  "version": "1.1.0",
  "description": "Design and customize professional certificate templates for your courses.",
  "publisher": "ClassroomIO",
  "icon": { "resource": "assets/icon.svg" },
  "license": "Apache-2.0",
  "engines": {
    "classroomio": ">=1.0.0",
    "pluginApi": "1.0.0"
  },
  "runtime": {
    "ui": {
      "entrypoints": {
        "studio": {
          "renderMode": "custom",
          "resource": "dist/studio.html"
        },
        "templatePicker": {
          "renderMode": "custom",
          "resource": "dist/picker.html"
        }
      }
    }
  },
  "permissions": {
    "required": [
      "organization.profile:read",
      "certificate.template:read",
      "certificate.template:write",
      "plugin.storage:read",
      "plugin.storage:write"
    ],
    "optional": []
  },
  "storage": {
    "documents": [
      {
        "namespace": "certificate-templates",
        "scope": "organization",
        "schemaVersion": 1,
        "schema": {
          "type": "object",
          "required": ["id", "name", "designVersion", "design", "revision", "isActive", "createdAt", "updatedAt"],
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string", "maxLength": 128 },
            "description": { "type": ["string", "null"], "maxLength": 500 },
            "designVersion": { "type": "integer", "minimum": 1 },
            "design": { "type": "object" },
            "revision": { "type": "integer", "minimum": 1 },
            "isActive": { "type": "boolean" },
            "createdAt": { "type": "string" },
            "updatedAt": { "type": "string" }
          }
        }
      }
    ]
  },
  "contributes": {
    "navigation": [
      {
        "id": "certificate-studio-navigation",
        "title": "Certificate Studio",
        "location": "organization.settings",
        "page": "certificate-studio",
        "icon": { "resource": "assets/icon.svg" },
        "visibility": "organization.admin"
      }
    ],
    "pages": [
      {
        "id": "certificate-studio",
        "entrypoint": "studio",
        "title": "Certificate Studio"
      }
    ],
    "slots": [
      {
        "id": "certificate-studio-template-picker",
        "target": "certificate.templates",
        "renderMode": "custom",
        "entrypoint": "templatePicker",
        "title": "Organization certificate templates"
      }
    ]
  },
  "dataPolicy": {
    "storesCustomerData": true,
    "retentionAfterUninstallDays": 30,
    "privacyPolicyUrl": "https://classroomio.com/privacy"
  }
}
