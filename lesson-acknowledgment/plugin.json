{
  "$schema": "https://classroomio.com/schemas/plugin.v1.json",
  "manifestVersion": 1,
  "id": "com.classroomio.lesson-acknowledgment",
  "name": "Lesson Feedback & Acknowledgment",
  "version": "1.2.0",
  "description": "Collects student ratings and feedback upon lesson completion, and provides instructors with aggregate satisfaction analytics and reviews.",
  "publisher": "classroomio",
  "icon": {
    "resource": "assets/icon.svg"
  },
  "license": "MIT",
  "engines": {
    "classroomio": ">=2.0.0",
    "pluginApi": "2026-10-08"
  },
  "runtime": {
    "ui": {
      "entrypoints": {
        "acknowledgment": {
          "renderMode": "custom",
          "resource": "dist/index.html"
        }
      }
    }
  },
  "contributes": {
    "slots": [
      {
        "id": "lesson-acknowledgment",
        "target": "lesson.after",
        "renderMode": "custom",
        "entrypoint": "acknowledgment",
        "title": "Lesson policy acknowledgment"
      }
    ]
  },
  "dataPolicy": {
    "storesCustomerData": true,
    "retentionAfterUninstallDays": 30,
    "privacyPolicyUrl": "https://classroomio.com/privacy"
  },
  "permissions": {
    "required": [
      "plugin.storage:read",
      "plugin.storage:write"
    ]
  },
  "storage": {
    "documents": [
      {
        "namespace": "lesson-acknowledgment",
        "scope": "user",
        "schemaVersion": 1,
        "schema": {
          "type": "object",
          "properties": {
            "rating": { "type": "number", "minimum": 1, "maximum": 5 },
            "comment": { "type": "string", "maxLength": 1000 },
            "completed": { "type": "boolean" },
            "userName": { "type": "string", "maxLength": 100 },
            "acknowledgedAt": { "type": "string", "minLength": 1 }
          },
          "required": ["acknowledgedAt"],
          "additionalProperties": false
        }
      }
    ]
  }
}
