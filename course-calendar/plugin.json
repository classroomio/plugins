{
  "$schema": "https://classroomio.com/schemas/plugin.v1.json",
  "manifestVersion": 1,
  "id": "com.classroomio.course-calendar",
  "slug": "course-calendar",
  "name": "Course & Live Calendar",
  "version": "1.0.0",
  "description": "View upcoming live course sessions, instructor schedules, and certificate deadlines across your academy.",
  "publisher": "ClassroomIO",
  "icon": {
    "resource": "assets/icon.svg"
  },
  "license": "Apache-2.0",
  "engines": {
    "classroomio": ">=2.0.0",
    "pluginApi": "2026-10-08"
  },
  "runtime": {
    "ui": {
      "entrypoints": {
        "calendar": {
          "renderMode": "custom",
          "resource": "dist/calendar.html"
        }
      }
    }
  },
  "contributes": {
    "navigation": [
      {
        "id": "course-calendar-navigation",
        "title": "Course Calendar",
        "location": "organization.navigation",
        "page": "course-calendar",
        "icon": {
          "resource": "assets/icon.svg"
        }
      }
    ],
    "pages": [
      {
        "id": "course-calendar",
        "entrypoint": "calendar",
        "title": "Course & Live Calendar"
      }
    ],
    "slots": [
      {
        "id": "course-calendar-sidebar",
        "target": "course.sidebar",
        "renderMode": "custom",
        "entrypoint": "calendar",
        "title": "Course Schedule"
      }
    ]
  },
  "dataPolicy": {
    "storesCustomerData": false,
    "retentionAfterUninstallDays": 0
  },
  "permissions": {
    "required": [
      "course.metadata:read",
      "lesson.metadata:read"
    ]
  }
}

