{
  "$schema": "https://classroomio.com/schemas/plugin.v1.json",
  "manifestVersion": 1,
  "id": "com.classroomio.landing-templates",
  "name": "Creative Landing Templates",
  "version": "1.0.0",
  "description": "Stunning, high-converting creative landing page templates for your academy.",
  "publisher": "ClassroomIO",
  "icon": {
    "resource": "assets/icon.svg"
  },
  "license": "Apache-2.0",
  "engines": {
    "classroomio": ">=2.0.0",
    "pluginApi": "2026-10-08"
  },
  "runtime": {
    "ui": {
      "entrypoints": {
        "picker": {
          "renderMode": "custom",
          "resource": "dist/picker.html"
        },
        "render": {
          "renderMode": "custom",
          "resource": "dist/render.html"
        }
      }
    }
  },
  "contributes": {
    "slots": [
      {
        "id": "landing-templates-picker",
        "target": "landing.templates",
        "renderMode": "custom",
        "pickerEntrypoint": "picker",
        "publicRendererEntrypoint": "render",
        "publicViewModelVersion": 1,
        "title": "Creative Landing Templates",
        "templates": [
          {
            "id": "neo-brutalism",
            "name": "Vanguard SaaS",
            "description": "High-impact SaaS academy with vibrant surfaces, browser-framed media, and bento cards.",
            "thumbnail": "assets/neo-brutalism-thumb.svg"
          },
          {
            "id": "midnight-aurora",
            "name": "Obsidian Horizon",
            "description": "Deep obsidian dark luxury with ambient radial glow, frosted glass cards, and luminous accents.",
            "thumbnail": "assets/midnight-aurora-thumb.svg"
          },
          {
            "id": "atelier",
            "name": "Atelier Minimal",
            "description": "Nordic architectural aesthetic with editorial serif typography and book-jacket cards.",
            "thumbnail": "assets/atelier-thumb.svg"
          }
        ]
      }
    ]
  },
  "permissions": {
    "required": []
  },
  "dataPolicy": {
    "storesCustomerData": false,
    "retentionAfterUninstallDays": 0
  }
}
