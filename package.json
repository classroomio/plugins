{
  "name": "classroomio-plugins",
  "version": "1.0.0",
  "private": true,
  "description": "Source-reviewed ClassroomIO plugins",
  "type": "module",
  "engines": {
    "node": "^20.19.3"
  },
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "build": "pnpm -r --filter=!classroomio-plugins run build",
    "check": "node scripts/run-registry-script.mjs check",
    "test": "node scripts/run-registry-script.mjs test",
    "pack": "cio-plugin build --registry registry/plugins.json",
    "seed": "cio-plugin dev",
    "release:verify": "node scripts/verify-release.mjs",
    "release:request": "node scripts/create-release-request.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.958.0",
    "@classroomio/plugin-sdk": "link:../classroomio/packages/plugin-sdk"
  }
}
